{
  "name": "@afcms/avro-zod",
  "version": "0.0.1",
  "description": "WIP, do not use.",
  "homepage": "https://github.com/AFCMS/avro-zod#readme",
  "bugs": {
    "url": "https://github.com/AFCMS/avro-zod/issues"
  },
  "license": "MIT",
  "author": "AFCMS <afcm.contact@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFCMS/avro-zod.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@vitest/coverage-v8": "^5.1.0",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  }
}
