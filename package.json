{
  "name": "@afcms/avro-zod",
  "version": "2.1.0",
  "description": "Convert Apache Avro schema declarations into Zod 4 validators.",
  "keywords": [
    "avro",
    "schema",
    "zod"
  ],
  "homepage": "https://github.com/AFCMS/avro-zod#readme",
  "bugs": {
    "url": "https://github.com/AFCMS/avro-zod/issues"
  },
  "license": "MIT",
  "author": {
    "name": "AFCMS",
    "email": "afcm.contact@gmail.com",
    "url": "https://afcms.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFCMS/avro-zod.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/AFCMS"
    }
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@vitest/coverage-v8": "^5.1.1",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  }
}
